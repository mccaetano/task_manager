SERVER_PORT=8080

# Example datasource settings:
SPRING_DATASOURCE_URL=jdbc:hsqldb:file:data/db
SPRING_DATASOURCE_DRIVER=org.hsqldb.jdbc.JDBCDriver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Generate an RSA key pair and point these values to the PEM files.
JWT_PUBLIC_KEY_LOCATION=classpath:keys/public.pem
JWT_PRIVATE_KEY_LOCATION=classpath:keys/private.pem
JWT_ISSUER=task-manager
JWT_EXPIRATION=PT1H
